# SmartCorp AI frontend environment
# Copy to .env for local overrides. Never commit real secrets.

# Django API base URL (Phase 1). Until then the app runs on the mock service layer.
VITE_API_URL=http://localhost:8000/api

# false = call the real API via services/request(); anything else (or unset) = mock data
VITE_USE_MOCK=true

# Sub-path hosting base (e.g. GitHub Pages project site). Leave unset for domain-root hosting.
# VITE_BASE=/SmartCorpAI/
