# SmartCorp AI backend environment — copy to backend/.env (NEVER commit .env)
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=True
DATABASE_URL=postgres://postgres:smartcorp@127.0.0.1:5433/smartcorp
REDIS_URL=redis://127.0.0.1:6379/0
# Eager Celery (run tasks inline, no worker needed). Set False with a real Redis+worker.
CELERY_EAGER=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Phase 2 providers. Local embeddings are deterministic and free for development/tests.
EMBEDDING_PROVIDER=local
LLM_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
